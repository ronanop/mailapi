PORT=3010
BASE_URL=http://localhost:3010
NODE_ENV=development

SESSION_SECRET=change-me-to-a-long-random-secret
ADMIN_PASSWORD=change-me-admin-password

# Microsoft 365 Graph (app-only / client credentials)
MS_GRAPH_TENANT_ID=your-tenant-id
MS_GRAPH_CLIENT_ID=your-app-client-id
MS_GRAPH_CLIENT_SECRET=your-app-client-secret
MS_GRAPH_OBJECT_ID=optional-user-object-id
MS_GRAPH_SECRET_ID=optional-secret-id
# Prefer mailbox email/UPN (OBJECT_ID is often the app object id, not the mailbox)
MS_GRAPH_MAILBOX=noc@yourdomain.com

DATA_DIR=./data
